{
  "name": "zookids",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "node -e \"const f='node_modules/three/build/three.cjs'; if(require('fs').existsSync(f)){let c=require('fs').readFileSync(f,'utf8'); if(!c.includes('typeof process.emitWarning')){ c=c.replace('process.emitWarning(', 'if(typeof process!==\\\"undefined\\\"&&typeof process.emitWarning===\\\"function\\\")process.emitWarning('); require('fs').writeFileSync(f,c); console.log('[patch] three.cjs patched for React Native');}}\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.1.4",
    "@react-navigation/native-stack": "^7.3.8",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "axios": "^1.20.0",
    "expo": "^57.0.20",
    "expo-font": "~57.0.3",
    "expo-gl": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0"
  },
  "private": true
}
