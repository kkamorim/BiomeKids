  /**
   * Helper para resolver a configuração do bioma por qualquer identificador:
   * nome (ex: 'FLORESTAS TROPICAIS', 'Pantanal'), id numérico ('1') ou chave ('savanas')
   */
  function getBiomeConfig(keyOrId) {
    if (!keyOrId) return BIOMES_CONFIG['florestas-tropicais'];
    var normalized = String(keyOrId).toLowerCase().trim();

    // Busca direta por chave
    if (BIOMES_CONFIG[normalized]) {
      return BIOMES_CONFIG[normalized];
    }

    // Busca por id numérico ou nome
    for (var key in BIOMES_CONFIG) {
      var config = BIOMES_CONFIG[key];
      if (config.numericId === normalized || config.id === normalized || config.nome.toLowerCase().includes(normalized) || normalized.includes('floresta') && key.includes('florestas-tropicais') || normalized.includes('pantanal') && key.includes('areas-umidas') || normalized.includes('amaz') && key.includes('florestas-tropicais') || normalized.includes('cerrado') && key.includes('savanas') || normalized.includes('caatinga') && key.includes('desertos') || normalized.includes('pampa') && key.includes('campos-pradarias')) {
        return config;
      }
    }
    return BIOMES_CONFIG['florestas-tropicais'];
  }
