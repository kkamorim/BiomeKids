   * @type {number}
   * @constant
   */
  var NotEqualStencilFunc = 517;

  /**
   * Will return true if the stencil reference value is greater than or equal to the current stencil value.
   *
   * @type {number}
   * @constant
   */
  var GreaterEqualStencilFunc = 518;

  /**
   * Will always return true.
   *
   * @type {number}
   * @constant
   */
