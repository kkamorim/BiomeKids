   * @type {number}
   * @constant
   */
  var GreaterCompare = 516;

  /**
   * Pass if the incoming value is not equal to the texture value.
   *
   * @type {number}
   * @constant
   */
  var NotEqualCompare = 517;

  /**
   * Pass if the incoming value is greater than or equal to the texture value.
   *
   * @type {number}
   * @constant
   */
