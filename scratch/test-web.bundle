      /**
       * Overwritten with a different texture type.
       *
       * @type {Data3DTexture}
       */
      this.texture = new Data3DTexture(null, width, height, depth);
      this._setTextureOptions(options);
      this.texture.isRenderTargetTexture = true;
    }
  }

  /**
